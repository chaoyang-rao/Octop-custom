new file mode 100644
index 0000000..3ab3bd3
--- /dev/null
+++ b/tests/test_skill_discovery.py
@@ -0,0 +1,244 @@
+"""Progressive skill discovery must use the current authorized catalog only."""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+from deepagents import create_deep_agent
+from deepagents.backends import FilesystemBackend
+from langchain.agents.middleware import ModelRequest
+from langchain.tools import ToolRuntime
+from langchain_core.language_models.fake_chat_models import FakeMessagesListChatModel
+from langchain_core.messages import AIMessage, BaseMessage, HumanMessage, SystemMessage, ToolMessage
+from langgraph.config import var_child_runnable_config
+
+from octop_harness.config import HarnessAgentConfig
+from octop_harness.middleware.conversation_mode import ConversationModeMiddleware, apply_conversation_mode_to_request
+from octop_harness.middleware.skill_discovery import SkillDiscoveryMiddleware, _order_skill_discovery
+from octop_harness.middleware.skill_filter import SkillFilterMiddleware
+
+
+@contextmanager
+def _config(thread: str = "thread", user: str = "alice", **extra: Any):
+    token = var_child_runnable_config.set({"configurable": {"thread_id": thread, "user": user, **extra}})
+    try:
+        yield
+    finally:
+        var_child_runnable_config.reset(token)
+
+
+def _skill(name: str, description: str = "unrelated workflow") -> dict[str, Any]:
+    return {"name": name, "description": description, "path": f"/skills/{name}/SKILL.md", "allowed_tools": []}
+
+
+def _catalog() -> list[dict[str, Any]]:
+    return [_skill(f"extra-{index}", "long description " * 70) for index in range(12)] + [
+        _skill("monthly-payroll", "薪酬月报与工资明细导出 Excel payroll report"),
+    ]
+
+
+def _middleware(tmp_path: Path) -> SkillDiscoveryMiddleware:
+    return SkillDiscoveryMiddleware(backend=FilesystemBackend(root_dir=tmp_path), sources=["/skills/"], language="zh")
+
+
+def _request(
+    mw: SkillDiscoveryMiddleware, *, text: str = "Explain this paragraph", loaded: list[str] | None = None
+) -> ModelRequest:
+    return ModelRequest(
+        model=SimpleNamespace(),
+        messages=[HumanMessage(content=text)],
+        system_message=SystemMessage(content="Keep the expert's business rules."),
+        tools=list(mw.tools),
+        state={"skills_metadata": _catalog(), "discovered_skill_names": loaded or []},
+    )
+
+
+def _runtime(*, thread: str = "thread", user: str = "alice") -> ToolRuntime:
+    return ToolRuntime(
+        state={},
+        context=None,
+        config={"configurable": {"thread_id": thread, "user": user}},
+        stream_writer=lambda _: None,
+        tool_call_id="search",
+        store=None,
+        tools=[],
+    )
+
+
+def test_large_catalog_is_not_sent_until_needed(tmp_path: Path) -> None:
+    mw = _middleware(tmp_path)
+    request = _request(mw)
+    with _config():
+        prepared = mw.modify_request(request)
+    assert "search_skills" in prepared.system_message.text
+    assert "monthly-payroll" not in prepared.system_message.text
+    assert "long description" not in prepared.system_message.text
+    assert len(prepared.system_message.text) < 2500
+    assert prepared.state is request.state
+    assert len(request.state["skills_metadata"]) == 13
+    assert request.system_message.text == "Keep the expert's business rules."
+
+
+def test_chinese_search_exposes_full_metadata_on_next_step(tmp_path: Path) -> None:
+    mw = _middleware(tmp_path)
+    with _config():
+        mw.modify_request(_request(mw))
+        found = mw._search("薪酬月报", 5, 0, _runtime())
+        assert found.update["discovered_skill_names"] == ["monthly-payroll"]
+        assert "/skills/monthly-payroll/SKILL.md" in found.update["messages"][0].text
+        prepared = mw.modify_request(_request(mw, loaded=found.update["discovered_skill_names"]))
+    assert "monthly-payroll" in prepared.system_message.text
+    assert "extra-0" not in prepared.system_message.text
+
+
+def test_search_cannot_resurrect_disabled_or_unselected_skills(tmp_path: Path) -> None:
+    mw = _middleware(tmp_path)
+    filter_mw = SkillFilterMiddleware(config=HarnessAgentConfig(skills_disabled=frozenset({"monthly-payroll"})))
+    with _config():
+        request = filter_mw._apply_filter(_request(mw))
+        mw.modify_request(request)
+        result = mw._search("薪酬月报", 5, 0, _runtime())
+    assert result.update["discovered_skill_names"] == []
+    assert "monthly-payroll" not in result.update["messages"][0].text
+    with _config(skills=["extra-0"]):
+        request = filter_mw._apply_filter(_request(mw))
+        prepared = mw.modify_request(request)
+        result = mw._search("*", 5, 0, _runtime())
+    assert "extra-0" in prepared.system_message.text
+    assert "monthly-payroll" not in result.update["messages"][0].text
+
+
+def test_catalog_is_scoped_to_current_actor_and_refreshed(tmp_path: Path) -> None:
+    mw = _middleware(tmp_path)
+    with _config():
+        mw.modify_request(_request(mw))
+    assert mw._search("薪酬月报", 5, 0, _runtime(user="bob")).update["discovered_skill_names"] == []
+    with _config():
+        request = _request(mw)
+        request.state["skills_metadata"] = []
+        mw.modify_request(request)
+    assert mw._search("薪酬月报", 5, 0, _runtime()).update["discovered_skill_names"] == []
+
+
+def test_explicit_slash_skill_is_available_without_search(tmp_path: Path) -> None:
+    mw = _middleware(tmp_path)
+    with _config():
+        prepared = mw.modify_request(_request(mw, text="/monthly-payroll 生成本月工资表"))
+    assert "/skills/monthly-payroll/SKILL.md" in prepared.system_message.text
+    assert "extra-0" not in prepared.system_message.text
+
+
+@pytest.mark.parametrize("mode", ["ask", "plan"])
+def test_discovery_does_not_restore_skills_in_read_only_modes(tmp_path: Path, mode: str) -> None:
+    mw = _middleware(tmp_path)
