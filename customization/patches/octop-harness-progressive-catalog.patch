+class _Model(FakeMessagesListChatModel):
+    seen: list[list[BaseMessage]] = []
+    bound_names: list[list[str]] = []
+
+    def bind_tools(self, tools: Any, **kwargs: Any) -> Any:
+        self.bound_names.append([getattr(tool, "name", "") for tool in tools])
+        return self
+
+    def _generate(self, messages: Any, stop: Any = None, run_manager: Any = None, **kwargs: Any) -> Any:
+        self.seen.append(list(messages))
+        return super()._generate(messages, stop=stop, run_manager=run_manager, **kwargs)
+
+
+def _graph(tmp_path: Path, model: _Model):
+    for skill in _catalog():
+        p = tmp_path / "skills" / skill["name"] / "SKILL.md"
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(
+            f"---\nname: {skill['name']}\ndescription: {skill['description']}\n---\nPAYROLL INSTRUCTIONS\n",
+            encoding="utf-8",
+        )
+    backend = FilesystemBackend(root_dir=tmp_path)
+    return create_deep_agent(
+        model=model,
+        backend=backend,
+        skills=["/skills/"],
+        middleware=[
+            SkillFilterMiddleware(config=HarnessAgentConfig(skills_disabled=frozenset({"extra-0"}))),
+            ConversationModeMiddleware(),
+            SkillDiscoveryMiddleware(backend=backend, sources=["/skills/"], language="zh"),
+        ],
+    )
+
+
+@pytest.mark.parametrize("mode", ["craft", "ask", "plan"])
+def test_real_graph_filters_before_rendering(tmp_path: Path, mode: str) -> None:
+    model = _Model(responses=[AIMessage(content="ok")], seen=[], bound_names=[])
+    graph = _graph(tmp_path, model)
+    graph.invoke(
+        {"messages": [HumanMessage(content="Explain this paragraph")]},
+        {"configurable": {"thread_id": "graph", "user": "alice", "conversation_mode": mode}},
+    )
+    prompt = "\n".join(m.text for m in model.seen[0] if isinstance(m, SystemMessage))
+    assert "extra-0" not in prompt
+    assert "long description" not in prompt
+    assert ("search_skills" in model.bound_names[0]) is (mode == "craft")
+
