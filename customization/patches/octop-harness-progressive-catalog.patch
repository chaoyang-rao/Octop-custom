+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.asyncio
+async def test_real_graph_search_and_read_use_normal_tool_execution(tmp_path: Path, asynchronous: bool) -> None:
+    model = _Model(
+        responses=[
+            AIMessage(content="", tool_calls=[{"id": "find", "name": "search_skills", "args": {"query": "薪酬月报"}}]),
+            AIMessage(
+                content="",
+                tool_calls=[
+                    {"id": "read", "name": "read_file", "args": {"file_path": "/skills/monthly-payroll/SKILL.md"}}
+                ],
+            ),
+            AIMessage(content="complete"),
+        ],
+        seen=[],
+        bound_names=[],
+    )
+    graph = _graph(tmp_path, model)
+    inputs = {"messages": [HumanMessage(content="Generate the payroll report")]}
+    config = {"configurable": {"thread_id": "graph", "user": "alice", "conversation_mode": "craft"}}
+    result = await graph.ainvoke(inputs, config) if asynchronous else graph.invoke(inputs, config)
+    assert result["messages"][-1].text == "complete"
+    assert any(isinstance(m, ToolMessage) and "PAYROLL INSTRUCTIONS" in m.text for m in result["messages"])
+    assert "monthly-payroll" in "\n".join(m.text for m in model.seen[-1] if isinstance(m, SystemMessage))
